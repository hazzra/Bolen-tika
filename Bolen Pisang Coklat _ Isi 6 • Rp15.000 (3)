.brand-copy span { letter-spacing: 2px; font-size: 16px; font-weight: 900; }

.brand-copy small { color: rgb(191, 169, 145); letter-spacing: 2px; margin-top: 5px; font-size: 9px; }

.fresh-badge { color: rgb(246, 201, 111); letter-spacing: 1.5px; border: 1px solid rgba(245, 189, 85, 0.35); border-radius: 999px; margin-left: auto; padding: 8px 12px; font-size: 11px; font-weight: 800; }

