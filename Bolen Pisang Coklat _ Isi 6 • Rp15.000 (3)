.menu-pills { flex-wrap: wrap; gap: 8px; margin: 0px 0px 18px; display: flex; }

.menu-pills span { color: rgb(234, 213, 185); background: rgba(255, 255, 255, 0.035); border: 1px solid rgba(245, 189, 85, 0.25); border-radius: 999px; padding: 8px 11px; font-size: 10px; font-weight: 700; }

