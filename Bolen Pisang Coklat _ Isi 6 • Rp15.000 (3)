.topbar, .hero, .footer { z-index: 1; max-width: 1120px; margin: auto; position: relative; }

.topbar { border-bottom: 1px solid var(--line); align-items: center; gap: 12px; padding-bottom: 24px; display: flex; }

.brand-mark { color: rgb(43, 23, 13); letter-spacing: -1px; background: rgb(242, 184, 76); border-radius: 13px; place-items: center; width: 44px; height: 44px; font-weight: 900; display: grid; }

